[
  {
    "path": "/storage/emulated/0/Download/*",
    "category": "Downloads",
    "program": "System",
    "remove_files": true,
    "remove_directories": true
  },
  {
    "path": "/storage/emulated/0/Movies/TikTok/*",
    "category": "Downloads",
    "program": "TikTok",
    "remove_files": true,
    "remove_directories": true
  },
  {
    "path": "/storage/emulated/0/DCIM/Camera/*",
    "category": "Images",
    "program": "Camera",
    "remove_files": true,
    "remove_directories": true
  },
  {
    "path": "/storage/emulated/0/Pictures/*",
    "category": "Images",
    "program": "Camera",
    "remove_files": true
  },
  {
    "path": "/storage/emulated/0/Pictures/Screenshots/*",
